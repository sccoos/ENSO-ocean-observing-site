---
import CoastalConditionsTabs from "./CoastalConditionsTabs.astro";
import CoastalErosion from "../tab-content/coastal-erosion.mdx";
import EcosystemImpacts from "../tab-content/ecosystem-impacts.mdx";
import Faq from "../tab-content/faq.mdx";
import OffshoreConditions from "../tab-content/offshore-conditions.mdx";
import Overview from "../tab-content/overview.mdx";
import Upwelling from "../tab-content/upwelling.mdx";

const tabs = [
  { id: "overview", route: "overview", label: "Overview", Content: Overview },
  {
    id: "coastal-conditions",
    route: "coastal-conditions",
    label: "Coastal Conditions",
    Content: CoastalConditionsTabs
  },
  { id: "offshore-conditions", route: "offshore-conditions", label: "Offshore Conditions", Content: OffshoreConditions },
  { id: "upwelling", route: "upwelling", label: "Upwelling", Content: Upwelling },
  {
    id: "coastal-erosion",
    route: "coastal-erosion",
    label: "Coastal Erosion",
    Content: CoastalErosion,
    disabled: true
  },
  {
    id: "ecosystem-impacts",
    route: "ecosystem-impacts",
    label: "Ecosystem Impacts",
    Content: EcosystemImpacts,
    disabled: true
  },
  { id: "faq-resources", route: "faq-resources", label: "Additional Resources", Content: Faq }
];

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="tab-demo" aria-label="Ocean observing topics">
  <header class="relative flex w-full flex-wrap border-b border-navbar-line bg-navbar md:flex-nowrap md:justify-start">
    <nav class="site-navbar__inner md:flex md:items-center md:justify-between" aria-label="Ocean observing topics">
      <div class="flex items-center justify-between py-3">
        <a class="flex flex-none items-center gap-x-2 text-sm font-semibold text-foreground focus:outline-hidden focus:opacity-80" href={baseUrl || "/"}>
          <span class="site-navbar__brand-title site-navbar__brand-title--full">California Ocean Observing Systems: Tracking El Niño</span>
          <span class="site-navbar__brand-title site-navbar__brand-title--compact">CalOOS: Tracking El Niño</span>
        </a>
        <span class="site-navbar__current-page mr-2 text-sm font-medium text-muted-foreground md:hidden" data-current-page aria-live="polite">Overview</span>
        <div class="md:hidden">
          <button
            type="button"
            class="hs-collapse-toggle relative flex size-9 items-center justify-center gap-x-2 rounded-lg border border-layer-line bg-layer text-layer-foreground shadow-2xs hover:bg-layer-hover focus:outline-hidden focus:bg-layer-focus disabled:pointer-events-none disabled:opacity-50"
            id="observing-topic-navbar-toggle"
            aria-expanded="false"
            aria-controls="observing-topic-navbar"
            aria-label="Toggle topic navigation"
            data-hs-collapse="#observing-topic-navbar"
          >
            <svg class="hs-collapse-open:hidden size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="3" x2="21" y1="6" y2="6" />
              <line x1="3" x2="21" y1="12" y2="12" />
              <line x1="3" x2="21" y1="18" y2="18" />
            </svg>
            <svg class="hs-collapse-open:block hidden size-4 shrink-0" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 6 6 18" />
              <path d="m6 6 12 12" />
            </svg>
          </button>
        </div>
      </div>

      <div
        id="observing-topic-navbar"
        class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 md:block md:grow-0 md:basis-auto"
        aria-labelledby="observing-topic-navbar-toggle"
        role="region"
      >
        <div class="flex flex-col gap-1 py-3 md:flex-row md:items-center md:justify-end md:gap-x-5 md:py-0" role="tablist" aria-orientation="horizontal">
          {
            tabs.filter((tab) => !tab.disabled).map((tab, index) => (
              <button
                type="button"
                class:list={[
                  "hs-tab-active:font-semibold hs-tab-active:text-primary-active hs-tab-active:after:bg-primary-active relative inline-flex items-center rounded-lg px-3 py-2 text-left text-sm text-navbar-nav-foreground hover:text-primary-hover focus:outline-hidden focus:text-primary-focus disabled:pointer-events-none disabled:opacity-50 md:rounded-none md:px-1 md:py-4 md:after:absolute md:after:-bottom-px md:after:inset-x-0 md:after:h-0.5 md:after:w-full md:after:bg-transparent",
                  index === 0 && "active"
                ]}
                id={`${tab.id}-tab`}
                data-tab-route={tab.route}
                disabled={tab.disabled}
                aria-disabled={tab.disabled ? "true" : undefined}
                aria-selected={index === 0 ? "true" : "false"}
                data-hs-tab={`#${tab.id}-panel`}
                aria-controls={`${tab.id}-panel`}
                role="tab"
              >
                {tab.label}
              </button>
            ))
          }
        </div>
      </div>
    </nav>
  </header>

  <div class="site-page tab-demo__panels">
    {
      tabs.map(({ id, Content }, index) => (
        <div
          id={`${id}-panel`}
          class:list={["tab-demo__panel", index !== 0 && "hidden"]}
          role="tabpanel"
          aria-labelledby={`${id}-tab`}
        >
          <Content />
        </div>
      ))
    }
  </div>
</section>
