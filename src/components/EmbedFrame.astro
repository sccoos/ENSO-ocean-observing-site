---
interface Props {
  src: string;
  title: string;
  aspectRatio?: string;
  height?: string;
  maxHeight?: string;
}

const {
  src,
  title,
  aspectRatio = "16 / 9",
  height,
  maxHeight
} = Astro.props;
---

<figure class="my-6 overflow-hidden rounded-xl border border-border bg-layer shadow-sm">
  <div class="embed-frame__viewport">
    <iframe
      class="block w-full border-0"
      src={src}
      title={title}
      loading="lazy"
      referrerpolicy="origin"
      sandbox="allow-same-origin allow-scripts"
      style={`${height ? `height: ${height};` : `aspect-ratio: ${aspectRatio};`}${maxHeight ? ` max-height: ${maxHeight};` : ""}`}
    ></iframe>
  </div>
</figure>
