---
interface Props {
  src: string;
  title: string;
  aspectRatio?: string;
  mobileAspectRatio?: string;
  height?: string;
  maxHeight?: string;
  iframeId?: string;
  topCrop?: string;
}

const {
  src,
  title,
  aspectRatio = "16 / 9",
  mobileAspectRatio = "1 / 1",
  height,
  maxHeight,
  iframeId,
  topCrop
} = Astro.props;

const viewportStyle = height && topCrop ? `height: ${height}; overflow: hidden;` : undefined;
const iframeStyle = [
  height ? `height: ${topCrop ? `calc(${height} + ${topCrop})` : height};` : "",
  maxHeight ? `max-height: ${maxHeight};` : "",
  topCrop ? `transform: translateY(calc(${topCrop} * -1));` : ""
].filter(Boolean).join(" ");
---

<figure
  class="embed-frame my-6 overflow-hidden rounded-xl border border-border bg-layer shadow-sm"
  data-embed-frame
  data-embed-aspect-ratio={height ? undefined : ""}
  style={height ? undefined : `--embed-frame-desktop-aspect-ratio: ${aspectRatio}; --embed-frame-mobile-aspect-ratio: ${mobileAspectRatio};`}
>
  <div class="embed-frame__viewport" style={viewportStyle}>
    <iframe
      id={iframeId}
      class="block w-full border-0"
      src={src}
      title={title}
      loading="lazy"
      referrerpolicy="origin"
      style={iframeStyle}
    ></iframe>
  </div>
  <div class="embed-frame__loading" role="status" aria-label="Loading dashboard">
    <span class="inline-flex gap-x-1" aria-hidden="true">
      <span class="size-1.5 rounded-full bg-surface-4 animate-[typing_1s_ease-in-out_infinite]"></span>
      <span class="size-1.5 rounded-full bg-surface-4 animate-[typing_1s_ease-in-out_infinite_0.2s]"></span>
      <span class="size-1.5 rounded-full bg-surface-4 animate-[typing_1s_ease-in-out_infinite_0.4s]"></span>
    </span>
  </div>
</figure>

<script>
  document.querySelectorAll<HTMLIFrameElement>("[data-embed-frame] iframe").forEach((iframe) => {
    iframe.addEventListener("load", () => {
      const loader = iframe.closest<HTMLElement>("[data-embed-frame]")
        ?.querySelector<HTMLElement>(".embed-frame__loading");

      window.setTimeout(() => loader?.setAttribute("hidden", ""), 500);
    }, { once: true });
  });
</script>
