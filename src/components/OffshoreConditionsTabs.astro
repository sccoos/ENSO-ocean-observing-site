---
import Gliders from "../tab-content/offshore-conditions-gliders.mdx";
import Satellite from "../tab-content/offshore-conditions-satellite.mdx";
import ShipBasedSampling from "../tab-content/offshore-conditions-ship-based-sampling.mdx";
import Models from "../tab-content/offshore-conditions-models.mdx";

const tabs = [
  { id: "gliders", route: "offshore-conditions/gliders", label: "Gliders", coverage: "Subsurface", Content: Gliders },
  { id: "satellite", route: "offshore-conditions/satellite", label: "Satellite", coverage: "Surface", Content: Satellite },
  {
    id: "ship-based-sampling",
    route: "offshore-conditions/ship-based-sampling",
    label: "Ship-based",
    coverage: "Surface, Subsurface",
    Content: ShipBasedSampling
  },
  { id: "models", route: "offshore-conditions/models", label: "Models", coverage: "Surface, Subsurface", Content: Models }
];
---

<section aria-label="Offshore condition observations">
  <nav
    class="grid grid-cols-2 gap-2 sm:grid-cols-4"
    aria-label="Offshore condition observation types"
    role="tablist"
    aria-orientation="horizontal"
  >
    {
      tabs.map((tab, index) => (
        <button
          type="button"
          class:list={[
            "offshore-observation-tab flex min-h-28 min-w-0 flex-col items-center justify-center gap-2 rounded-xl border px-4 py-4 text-center text-sm font-medium transition-[color,background-color,border-color,box-shadow] focus:outline-hidden focus:ring-2 focus:ring-primary disabled:pointer-events-none disabled:opacity-50",
            index === 0 && "active"
          ]}
          id={`offshore-conditions-${tab.id}-tab`}
          data-tab-route={tab.route}
          aria-selected={index === 0 ? "true" : "false"}
          data-hs-tab={`#offshore-conditions-${tab.id}-panel`}
          aria-controls={`offshore-conditions-${tab.id}-panel`}
          role="tab"
        >
          {
            tab.id === "gliders" && (
              <svg class="size-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 18h18" />
                <path d="M6 18 9 8l3 5 3-5 3 10" />
                <path d="M9 8V4" />
              </svg>
            )
          }
          {
            tab.id === "satellite" && (
              <svg class="size-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m10 13 4-4" />
                <path d="m7 10-3-3m13 10 3 3" />
                <rect x="8" y="8" width="8" height="8" rx="1" />
                <path d="m3 21 4-4m10-10 4-4" />
              </svg>
            )
          }
          {
            tab.id === "ship-based-sampling" && (
              <svg class="size-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 17h18l-3 3H6l-3-3Z" />
                <path d="M8 17V7h8v10" />
                <path d="M12 7V3" />
                <path d="M5 21c1 1 3 1 4 0 1 1 3 1 4 0 1 1 3 1 4 0" />
              </svg>
            )
          }
          {
            tab.id === "models" && (
              <svg class="size-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 19V5" />
                <path d="M4 19h16" />
                <path d="m7 15 4-4 3 2 5-6" />
                <circle cx="7" cy="15" r="1" />
                <circle cx="11" cy="11" r="1" />
                <circle cx="14" cy="13" r="1" />
                <circle cx="19" cy="7" r="1" />
              </svg>
            )
          }
          <span class="flex flex-col leading-tight">
            <span>{tab.label}</span>
            <span class="mt-0.5 text-xs opacity-70">{tab.coverage}</span>
          </span>
        </button>
      ))
    }
  </nav>

  <div class="mt-6">
    {
      tabs.map(({ id, Content }, index) => (
        <div
          id={`offshore-conditions-${id}-panel`}
          class:list={[index !== 0 && "hidden"]}
          role="tabpanel"
          aria-labelledby={`offshore-conditions-${id}-tab`}
        >
          <Content />
        </div>
      ))
    }
  </div>
</section>
