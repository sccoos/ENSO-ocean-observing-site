---
import Gliders from "../tab-content/offshore-conditions-gliders.mdx";
import Satellite from "../tab-content/offshore-conditions-satellite.mdx";
import ShipBasedSampling from "../tab-content/offshore-conditions-ship-based-sampling.mdx";

const tabs = [
  { id: "gliders", route: "offshore-conditions/gliders", label: "Subsurface - Gliders", Content: Gliders },
  { id: "satellite", route: "offshore-conditions/satellite", label: "Surface - Satellite", Content: Satellite },
  {
    id: "ship-based-sampling",
    route: "offshore-conditions/ship-based-sampling",
    label: "Ship-based sampling",
    Content: ShipBasedSampling
  }
];
---

<section aria-label="Offshore condition observations">
  <div class="border-b border-line-2">
    <nav
      class="flex gap-x-1 overflow-x-auto overflow-y-hidden"
      aria-label="Offshore condition observation types"
      role="tablist"
      aria-orientation="horizontal"
    >
      {
        tabs.map((tab, index) => (
          <button
            type="button"
            class:list={[
              "hs-tab-active:bg-layer hs-tab-active:border-b-transparent hs-tab-active:text-primary-active -mb-px inline-flex items-center gap-x-2 rounded-t-lg border border-line-2 bg-muted px-4 py-3 text-center text-sm font-medium text-muted-foreground-1 hover:text-foreground focus:outline-hidden focus:text-foreground disabled:pointer-events-none disabled:opacity-50",
              index === 0 && "active"
            ]}
            id={`offshore-conditions-${tab.id}-tab`}
            data-tab-route={tab.route}
            aria-selected={index === 0 ? "true" : "false"}
            data-hs-tab={`#offshore-conditions-${tab.id}-panel`}
            aria-controls={`offshore-conditions-${tab.id}-panel`}
            role="tab"
          >
            {tab.label}
          </button>
        ))
      }
    </nav>
  </div>

  <div class="mt-3">
    {
      tabs.map(({ id, Content }, index) => (
        <div
          id={`offshore-conditions-${id}-panel`}
          class:list={[index !== 0 && "hidden"]}
          role="tabpanel"
          aria-labelledby={`offshore-conditions-${id}-tab`}
        >
          <Content />
        </div>
      ))
    }
  </div>
</section>
