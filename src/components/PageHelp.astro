---
import { pageHelp } from "../data/page-help";
---

<button class="page-help-button" type="button" aria-haspopup="dialog" aria-controls="page-help-dialog" data-page-help-open hidden>
  <span aria-hidden="true">?</span>
  <span class="sr-only">About this page</span>
</button>

<dialog class="page-help-dialog" id="page-help-dialog" aria-labelledby="page-help-title" data-page-help-dialog>
  <div class="page-help-dialog__header">
    <h2 id="page-help-title">How to use this view</h2>
    <button class="page-help-dialog__close" type="button" aria-label="Close about this page dialog" data-page-help-close>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 6 12 12" />
        <path d="m18 6-12 12" />
      </svg>
    </button>
  </div>
  <div class="page-help-dialog__content" data-page-help-content-container>
    <p>Details for this section will be added soon.</p>
  </div>
</dialog>

{
  Object.entries(pageHelp).map(([route, content]) => (
    <template data-page-help-content={route} set:html={content} />
  ))
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-page-help-dialog]');
  const contentContainer = document.querySelector<HTMLElement>('[data-page-help-content-container]');
  const openButton = document.querySelector<HTMLButtonElement>('[data-page-help-open]');

  function helpTemplateFor(route: string) {
    const segments = route.split("/").filter(Boolean);

    while (segments.length) {
      const candidate = segments.join("/");
      const template = [...document.querySelectorAll<HTMLTemplateElement>("[data-page-help-content]")]
        .find((item) => item.dataset.pageHelpContent === candidate);
      if (template) return template;
      segments.pop();
    }
  }

  function updateHelpContent() {
    if (!contentContainer) return;

    const template = helpTemplateFor(window.location.hash.slice(1));
    if (template) {
      contentContainer.replaceChildren(template.content.cloneNode(true));
      return;
    }

    contentContainer.replaceChildren(Object.assign(document.createElement("p"), {
      textContent: "Details for this section will be added soon."
    }));
  }

  function updateHelpButton(route = window.location.hash.slice(1)) {
    if (!openButton) return;
    openButton.hidden = !helpTemplateFor(route);
  }

  document.querySelector('[data-page-help-open]')?.addEventListener("click", () => {
    if (!dialog) return;
    updateHelpContent();
    dialog.showModal();
  });

  document.querySelector('[data-page-help-close]')?.addEventListener("click", () => dialog?.close());

  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });

  window.addEventListener("tabroutechange", (event) => {
    const route = (event as CustomEvent<{ route: string }>).detail.route;
    updateHelpButton(route);
  });

  updateHelpButton();
</script>
