---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <nav class="site-footer__partners" aria-label="Partner organizations">
      <a class="site-footer__partner" href="https://cencoos.org/">
        <img src={`${baseUrl}/images/partners/cencoos-logo-alpha.png`} alt="Central and Northern California Ocean Observing System" />
      </a>
      <a class="site-footer__partner" href="https://ioos.noaa.gov/">
        <img src={`${baseUrl}/images/partners/ioos-logo-alpha.png`} alt="Integrated Ocean Observing System" />
      </a>
      <a class="site-footer__partner" href="https://sccoos.org/">
        <img src={`${baseUrl}/images/partners/sccoos-logo-alpha.webp`} alt="Southern California Coastal Ocean Observing System" />
      </a>
    </nav>
    <div class="site-footer__feedback">
      <button type="button" class="site-footer__feedback-button" data-feedback-open aria-haspopup="dialog" aria-controls="feedback-dialog">Give feedback</button>
    </div>
  </div>
</footer>

<dialog class="page-help-dialog feedback-dialog" id="feedback-dialog" aria-labelledby="feedback-title" data-feedback-dialog>
  <div class="page-help-dialog__header">
    <h2 id="feedback-title">Give feedback</h2>
    <button class="page-help-dialog__close" type="button" aria-label="Close feedback dialog" data-feedback-close>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 6 12 12" /><path d="m18 6-12 12" /></svg>
    </button>
  </div>
  <iframe data-feedback-frame title="Feedback form" loading="lazy" src="about:blank"></iframe>
  <p class="feedback-dialog__fallback"><a href="https://forms.gle/yF2QTupQE7GDrbu77" target="_blank" rel="noopener noreferrer">Open the feedback form in a new tab</a></p>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-feedback-dialog]");
  const frame = document.querySelector<HTMLIFrameElement>("[data-feedback-frame]");
  document.querySelector("[data-feedback-open]")?.addEventListener("click", () => {
    if (!dialog || !frame) return;
    if (frame.getAttribute("src") === "about:blank") {
      frame.src = "https://docs.google.com/forms/d/e/1FAIpQLSdUclGy3s0ID0_usYX_GZU1bdi-ueN_wh6YRwPLcDdXUhMVIA/viewform?embedded=true";
    }
    dialog.showModal();
  });
  document.querySelector("[data-feedback-close]")?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) dialog.close(); });
</script>
