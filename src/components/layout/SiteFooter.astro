---
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <nav class="site-footer__partners" aria-label="Partner organizations">
      <a class="site-footer__partner" href="https://cencoos.org/">
        <img src={`${baseUrl}/images/partners/cencoos-logo-alpha.png`} alt="Central and Northern California Ocean Observing System" />
      </a>
      <a class="site-footer__partner" href="https://ioos.noaa.gov/">
        <img src={`${baseUrl}/images/partners/ioos-logo-alpha.png`} alt="Integrated Ocean Observing System" />
      </a>
      <a class="site-footer__partner" href="https://sccoos.org/">
        <img src={`${baseUrl}/images/partners/sccoos-logo-alpha.webp`} alt="Southern California Coastal Ocean Observing System" />
      </a>
    </nav>
  </div>
</footer>
